# project_id: usually nothing to put here — it defaults to the same value
# as 0-foundation ("platform-factory-ref"). Copy to terraform.tfvars ONLY
# if you overrode project_id in 0-foundation's tfvars (e.g. because the
# default was already taken), and set the same value here so this layer
# can find foundation's state bucket.

# project_id = "platform-factory-ref"

# authorized_networks: REQUIRED, no default — the cluster's public
# control-plane endpoint rejects everyone until you list CIDRs here. Find
# your current public IP (curl -s ifconfig.me) and use it as a /32:
authorized_networks = [
  {
    cidr_block   = "203.0.113.5/32" # replace with `curl -s ifconfig.me`/32
    display_name = "operator-workstation"
  }
]
