<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="platform-bootstrap" id="platform-bootstrap">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2100" pageHeight="1400" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Platform Factory — platform-bootstrap: what is deployed today" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1980" height="30" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="GCP project platform-factory-ref, us-central1 · as of 2026-08-22 · ADR-0009 (corp-real posture), ADR-0010 (image plane), ADR-0011 (identity-gated access). Solid borders persist between sessions; dashed borders are rebuilt by scripts/cycle.sh. Three ways in, all gated by identity rather than by IP; one logged way out to the internet (Cloud NAT)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1980" height="44" as="geometry"/></mxCell>
        <mxCell id="op" value="&lt;b&gt;Operator laptop (Ronak)&lt;/b&gt;&lt;br&gt;gcloud · kubectl · terraform + helm · Tailscale client&lt;br&gt;terraform apply runs from here, one layer at a time (0 → 1 → 2 → 3); each layer reads the previous layer&amp;#x27;s outputs from remote state" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="240" height="150" as="geometry"/></mxCell>
        <mxCell id="i3" value="" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#00BEF2;shape=mxgraph.azure.laptop;pointerEvents=1;" vertex="1" parent="op"><mxGeometry x="12" y="62" width="44" height="26" as="geometry"/></mxCell>
        <mxCell id="waysin" value="Ways in — all identity-gated (ADR-0011)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="130" width="280" height="30" as="geometry"/></mxCell>
        <mxCell id="dns" value="&lt;b&gt;GKE DNS-based endpoint&lt;/b&gt;&lt;br&gt;*.gke.goog — a public name, authorized by IAM (short-lived gcloud token), publicly trusted certificate&lt;br&gt;no IP allowlist, no tunnel, no bastion" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="i4" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="dns"><mxGeometry x="12" y="33" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="iap" value="&lt;b&gt;IAP TCP forwarding (break-glass)&lt;/b&gt;&lt;br&gt;gcloud compute ssh --tunnel-through-iap&lt;br&gt;IAM: roles/iap.tunnelResourceAccessor, then OS Login&lt;br&gt;needs no egress: still works when NAT or the tailnet is broken" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="590" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="i5" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="iap"><mxGeometry x="13" y="43" width="42" height="44" as="geometry"/></mxCell>
        <mxCell id="ts" value="&lt;b&gt;Tailscale tailnet (SaaS)&lt;/b&gt;&lt;br&gt;coordination server + DERP relays; WireGuard tunnels are end-to-end encrypted&lt;br&gt;routes approved in the admin console; ACL allow-all today; Tailnet Lock deferred" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="380" y="800" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="i6" value="" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="ts"><mxGeometry x="12" y="46" width="44" height="28" as="geometry"/></mxCell>
        <mxCell id="gh" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;platform-factory/platform-config (main, path .) — watched by the Argo CD root Application&lt;br&gt;platform-bootstrap (this repo) — applied from the laptop" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="380" y="1000" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="i7" value="" style="dashed=0;outlineConnect=0;html=1;align=center;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;shape=mxgraph.weblogos.github" vertex="1" parent="gh"><mxGeometry x="12" y="33" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="reg" value="&lt;b&gt;Upstream image registries&lt;/b&gt;&lt;br&gt;quay.io (argocd) · ghcr.io (dex) · public.ecr.aws (redis) · Docker Hub · registry.k8s.io · xpkg.upbound.io" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="380" y="1190" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="i8" value="" style="image;sketch=0;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/mscae/Docker.svg;" vertex="1" parent="reg"><mxGeometry x="12" y="37" width="44" height="36" as="geometry"/></mxCell>
        <mxCell id="proj" value="GCP project platform-factory-ref · us-central1 · 0-foundation owns the project, billing link, 10 enabled APIs (deletion_policy = DELETE)" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;spacingLeft=8;fontSize=12;fontColor=#1a1a1a;fillColor=#e8e8e8;strokeColor=#8a8a8a;swimlaneFillColor=#fbfbfb;rounded=1;arcSize=4;pointerEvents=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="1300" height="1240" as="geometry"/></mxCell>
        <mxCell id="cp" value="&lt;b&gt;GKE control plane — regional, Google-managed (2-cluster)&lt;/b&gt;&lt;br&gt;no client IP endpoint at all, public or private (ip_endpoints_config.enabled = false): the DNS endpoint is the only way in&lt;br&gt;control-plane range 172.16.0.0/28 — what the nodes talk to&lt;br&gt;REGULAR channel · Workload Identity pool platform-factory-ref.svc.id.goog · no master_authorized_networks — IAM is the gate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;dashed=1;dashPattern=6 3;" vertex="1" parent="proj"><mxGeometry x="780" y="50" width="480" height="150" as="geometry"/></mxCell>
        <mxCell id="i9" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="cp"><mxGeometry x="14" y="53" width="40" height="44" as="geometry"/></mxCell>
        <mxCell id="vpc" value="1-network — VPC platform-factory-ref (custom mode) · persistent" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;spacingLeft=8;fontSize=12;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#eef6ec;rounded=1;arcSize=4;pointerEvents=0;strokeWidth=1.5;" vertex="1" parent="proj"><mxGeometry x="20" y="230" width="1260" height="760" as="geometry"/></mxCell>
        <mxCell id="fw" value="&lt;b&gt;Firewall rules (all logged)&lt;/b&gt;&lt;br&gt;allow-internal: all protocols from 10.10.0.0/20, 10.20.0.0/16, 10.30.0.0/20&lt;br&gt;allow-iap-ssh: tcp/22 from 35.235.240.0/20 (Google&amp;#x27;s IAP fleet) → tag jumpbox only&lt;br&gt;everything else: implicit deny on ingress · egress unrestricted (FQDN egress control is M3)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="vpc"><mxGeometry x="40" y="50" width="520" height="100" as="geometry"/></mxCell>
        <mxCell id="i10" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="fw"><mxGeometry x="12" y="28" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="vpn" value="&lt;b&gt;HA VPN + Cloud Router BGP to a UniFi peer&lt;/b&gt;&lt;br&gt;enable_vpn = false: written and validated, NOT built&lt;br&gt;superseded by ADR-0011 (Tailscale subnet router)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;opacity=45;textOpacity=55;" vertex="1" parent="vpc"><mxGeometry x="600" y="50" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="i11" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="vpn"><mxGeometry x="14" y="28" width="40" height="44" as="geometry"/></mxCell>
        <mxCell id="subnet" value="Subnet platform-factory-ref-subnet · 10.10.0.0/20 (nodes) · 10.20.0.0/16 (pods) · 10.30.0.0/20 (services) · Private Google Access ON" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;spacingLeft=8;fontSize=12;fontColor=#1a1a1a;fillColor=#cfe5cb;strokeColor=#82b366;swimlaneFillColor=#f7fbf6;rounded=1;arcSize=4;pointerEvents=0;strokeWidth=1.5;" vertex="1" parent="vpc"><mxGeometry x="20" y="170" width="1220" height="400" as="geometry"/></mxCell>
        <mxCell id="jb" value="&lt;b&gt;Jump box (e2-micro, Debian 12)&lt;/b&gt;&lt;br&gt;us-central1-a · no external IP · OS Login · can_ip_forward&lt;br&gt;Tailscale subnet router advertising the 3 ranges&lt;br&gt;SA jumpbox: roles/logging.logWriter only&lt;br&gt;joined to the tailnet once, by hand, over IAP" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="subnet"><mxGeometry x="20" y="60" width="280" height="150" as="geometry"/></mxCell>
        <mxCell id="i12" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="jb"><mxGeometry x="12" y="53" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="np" value="2-cluster — GKE node pool primary · disposable (cycle.sh down / up)" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;spacingLeft=8;fontSize=12;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#fff5e8;rounded=1;arcSize=4;pointerEvents=0;strokeWidth=1.5;dashed=1;dashPattern=8 4;" vertex="1" parent="subnet"><mxGeometry x="340" y="20" width="860" height="360" as="geometry"/></mxCell>
        <mxCell id="nodes" value="&lt;b&gt;3 worker nodes — e2-standard-4, 1 per zone × 3 zones (autoscaler 1–2 per zone), on-demand&lt;/b&gt;&lt;br&gt;private IPs only · Shielded VM (secure boot + integrity monitoring) · SA gke-nodes · reachable from the tailnet by node and pod IP — Service ClusterIPs are virtual and are NOT reachable" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;dashed=1;dashPattern=6 3;" vertex="1" parent="np"><mxGeometry x="20" y="40" width="820" height="80" as="geometry"/></mxCell>
        <mxCell id="i13" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=node" vertex="1" parent="nodes"><mxGeometry x="12" y="19" width="44" height="42" as="geometry"/></mxCell>
        <mxCell id="argo" value="3-argocd — namespace argocd · disposable · installed as two Terraform helm_releases" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;spacingLeft=8;fontSize=12;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#f3eef6;rounded=1;arcSize=4;pointerEvents=0;strokeWidth=1.5;dashed=1;dashPattern=8 4;" vertex="1" parent="np"><mxGeometry x="20" y="140" width="820" height="200" as="geometry"/></mxCell>
        <mxCell id="argocd" value="&lt;b&gt;Argo CD v3.4.6 (chart argo-cd 10.2.2)&lt;/b&gt;&lt;br&gt;server · repo-server · application controller · dex · redis&lt;br&gt;image paths rewritten to the Artifact Registry remotes (ADR-0010)&lt;br&gt;no public endpoint yet (follow-on work)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;dashed=1;dashPattern=6 3;" vertex="1" parent="argo"><mxGeometry x="20" y="40" width="360" height="140" as="geometry"/></mxCell>
        <mxCell id="i14" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=pod" vertex="1" parent="argocd"><mxGeometry x="12" y="49" width="44" height="42" as="geometry"/></mxCell>
        <mxCell id="root" value="&lt;b&gt;root Application (app-of-apps)&lt;/b&gt;&lt;br&gt;helm release root-app — a tiny in-repo chart, installed second so the Application CRD exists first&lt;br&gt;source: platform-config @ main, path .&lt;br&gt;syncPolicy automated: prune + selfHeal" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;dashed=1;dashPattern=6 3;" vertex="1" parent="argo"><mxGeometry x="460" y="40" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="i15" value="" style="aspect=fixed;sketch=0;html=1;dashed=0;whitespace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#2875E2;strokeColor=#ffffff;points=[[0.005,0.63,0],[0.1,0.2,0],[0.9,0.2,0],[0.5,0,0],[0.995,0.63,0],[0.72,0.99,0],[0.5,1,0],[0.28,0.99,0]];shape=mxgraph.kubernetes.icon2;prIcon=crd" vertex="1" parent="root"><mxGeometry x="12" y="49" width="44" height="42" as="geometry"/></mxCell>
        <mxCell id="nat" value="&lt;b&gt;Cloud NAT + Cloud Router&lt;/b&gt;&lt;br&gt;AUTO_ONLY external IPs · all subnets and ranges&lt;br&gt;logs ALL (translations + errors) → Cloud Logging — the C-23 evidence&lt;br&gt;moved here from 2-cluster on 2026-08-20 (ADR-0011)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="vpc"><mxGeometry x="40" y="610" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="i16" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="nat"><mxGeometry x="12" y="43" width="44" height="44" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Egress accounting (C-23).&lt;/b&gt; Image pulls ride Private Google Access to Artifact Registry and never touch NAT. NAT should only ever see (1) Argo CD&#x27;s git fetches to GitHub and (2) the jump box&#x27;s Tailscale coordination / DERP traffic. Anything else in the NAT logs is a violation. Egress is not yet FQDN-restricted — that is M3." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;" vertex="1" parent="vpc"><mxGeometry x="740" y="610" width="480" height="130" as="geometry"/></mxCell>
        <mxCell id="found" value="0-foundation · persistent (~$0 idle)" style="swimlane;startSize=30;html=1;fontStyle=1;align=left;spacingLeft=8;fontSize=12;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#eef4fc;rounded=1;arcSize=4;pointerEvents=0;strokeWidth=1.5;" vertex="1" parent="proj"><mxGeometry x="20" y="1020" width="1260" height="200" as="geometry"/></mxCell>
        <mxCell id="ar" value="&lt;b&gt;Artifact Registry remote repos (us-central1)&lt;/b&gt;&lt;br&gt;docker-hub · quay-io · ghcr-io · ecr-public · registry-k8s-io · xpkg-upbound-io&lt;br&gt;read-only pull-through caches; nodes read them as SA gke-nodes" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="found"><mxGeometry x="40" y="50" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="i17" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="ar"><mxGeometry x="12" y="40" width="44" height="40" as="geometry"/></mxCell>
        <mxCell id="tfstate" value="&lt;b&gt;GCS bucket platform-factory-ref-tfstate&lt;/b&gt;&lt;br&gt;versioned · uniform bucket-level access&lt;br&gt;Terraform state for all 4 layers, one prefix each; layers chain via terraform_remote_state" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="found"><mxGeometry x="380" y="50" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="i18" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="tfstate"><mxGeometry x="12" y="43" width="44" height="35" as="geometry"/></mxCell>
        <mxCell id="sa" value="&lt;b&gt;Service accounts (least privilege)&lt;/b&gt;&lt;br&gt;gke-nodes: container.defaultNodeServiceAccount + artifactregistry.reader&lt;br&gt;never the default Compute Engine SA (the org policy leaves it with no roles at all)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="found"><mxGeometry x="680" y="50" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="i19" value="" style="editableCssRules=.*;html=1;shape=image;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="sa"><mxGeometry x="17" y="38" width="35" height="44" as="geometry"/></mxCell>
        <mxCell id="logs" value="&lt;b&gt;Cloud Logging + Monitoring&lt;/b&gt;&lt;br&gt;GKE system + workload logs · NAT translation logs · firewall logs&lt;br&gt;APIs pinned explicitly — logging was silently OFF until 2026-08-13" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=64;spacingRight=6;spacingTop=2;spacingBottom=2;fontSize=11;fontColor=#1a1a1a;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="found"><mxGeometry x="980" y="50" width="260" height="120" as="geometry"/></mxCell>
